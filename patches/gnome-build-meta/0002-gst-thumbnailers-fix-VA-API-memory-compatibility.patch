From ccce9ac051cab1803ed8e17f416db0a4929e587c Mon Sep 17 00:00:00 2001
From: "Jorge O. Castro" <jorge.castro@gmail.com>
Date: Tue, 19 May 2026 23:11:40 -0400
Subject: [PATCH] gst-thumbnailers: fix VA-API memory compatibility in video
 thumbnailer

uridecodebin3 + vah264dec/vah265dec fails in gst-video-thumbnailer
because decodebin3 emits video/x-raw(memory:VAMemory) but cannot bridge
this to the downstream pipeline without a static connection.

Two changes:
1. Set uridecodebin3 caps="video/x-raw" so decodebin3 produces
   system-memory output natively (root cause fix).
2. Add videoconvert before videoscale as defense-in-depth.

Upstream report pending. Carried until gst-thumbnailers ships the fix.
---
 elements/core/gst-thumbnailers.bst            |  2 +
 ...ideo-fix-VA-API-memory-compatibility.patch | 70 +++++++++++++++++++
 2 files changed, 72 insertions(+)
 create mode 100644 patches/gst-thumbnailers/0001-video-fix-VA-API-memory-compatibility.patch

diff --git a/elements/core/gst-thumbnailers.bst b/elements/core/gst-thumbnailers.bst
index 324a0cfa..9c872abf 100644
--- a/elements/core/gst-thumbnailers.bst
+++ b/elements/core/gst-thumbnailers.bst
@@ -4,6 +4,8 @@ sources:
 - kind: tar
   url: gnome_downloads:gst-thumbnailers/1.0/gst-thumbnailers-1.0.0.tar.xz
   ref: f2a68019d319995d20a55cf0c32db1bb248834c2300ee757b417a5337d5d6497
+- kind: patch
+  path: patches/gst-thumbnailers/0001-video-fix-VA-API-memory-compatibility.patch
 - kind: cargo2
   ref:
   - kind: registry
diff --git a/patches/gst-thumbnailers/0001-video-fix-VA-API-memory-compatibility.patch b/patches/gst-thumbnailers/0001-video-fix-VA-API-memory-compatibility.patch
new file mode 100644
index 00000000..a11bf5d6
--- /dev/null
+++ b/patches/gst-thumbnailers/0001-video-fix-VA-API-memory-compatibility.patch
@@ -0,0 +1,70 @@
+From 5c99313d1fd51c5cb98b30dc05cebf9f5ff2097b Mon Sep 17 00:00:00 2001
+From: "Jorge O. Castro" <jorge.castro@gmail.com>
+Date: Tue, 19 May 2026 23:11:16 -0400
+Subject: [PATCH] video: fix VA-API memory compatibility in
+ gst-video-thumbnailer
+
+Two changes to get H.264/H.265 VA-API hardware decode working with
+gst-video-thumbnailer:
+
+1. Set uridecodebin3 caps="video/x-raw" to force system-memory output.
+   VA-API decoders (vah264dec, vah265dec) emit video/x-raw(memory:VAMemory)
+   frames. decodebin3 cannot bridge this to the downstream pipeline when
+   no static connection exists yet (only dynamic pad_added). Setting caps
+   on uridecodebin3 forces it to produce system-memory output internally.
+
+2. Add videoconvert before videoscale as defense-in-depth.
+   This is a no-op for system-memory frames but provides an explicit
+   download step in case any other hardware memory path slips through.
+---
+ src/lib.rs | 10 +++++++++-
+ 1 file changed, 9 insertions(+), 1 deletion(-)
+
+diff --git a/src/lib.rs b/src/lib.rs
+index 6e15cff..c9b4ff3 100644
+--- a/src/lib.rs
++++ b/src/lib.rs
+@@ -152,9 +152,15 @@ fn get_video_thumbnail_source(input_uri: &str, thumbnail_size: u16) -> Result<Th
+     // Source
+     let uridecodebin = gst::ElementFactory::make("uridecodebin3")
+         .property("uri", input_uri)
++        // Force system-memory output so videoscale can accept the decoded frames.
++        // Without this, VA-API decoders (vah264dec, vah265dec) output
++        // video/x-raw(memory:VAMemory) which decodebin3 cannot bridge to the
++        // downstream pipeline when no dynamic connection is yet established.
++        .property("caps", gst::Caps::builder("video/x-raw").build())
+         .build()?;
+ 
+     // Filters
++    let videoconvert_va = gst::ElementFactory::make("videoconvert").build()?;
+     let videoscale = gst::ElementFactory::make("videoscale").build()?;
+     let videoconvert = gst::ElementFactory::make("videoconvert").build()?;
+     let capsfilter = gst::ElementFactory::make("capsfilter").build()?;
+@@ -171,6 +177,7 @@ fn get_video_thumbnail_source(input_uri: &str, thumbnail_size: u16) -> Result<Th
+ 
+     pipeline.add_many([
+         &uridecodebin,
++        &videoconvert_va,
+         &videoscale,
+         &videoconvert,
+         &capsfilter,
+@@ -180,6 +187,7 @@ fn get_video_thumbnail_source(input_uri: &str, thumbnail_size: u16) -> Result<Th
+ 
+     // Static links
+     gst::Element::link_many([
++        &videoconvert_va,
+         &videoscale,
+         &videoconvert,
+         &capsfilter,
+@@ -263,7 +271,7 @@ fn get_video_thumbnail_source(input_uri: &str, thumbnail_size: u16) -> Result<Th
+                 capsfilter.set_property("caps", caps);
+ 
+                 // Link source pad to sink of first filter
+-                let sink_pad = videoscale.static_pad("sink").unwrap();
++                let sink_pad = videoconvert_va.static_pad("sink").unwrap();
+                 if !sink_pad.is_linked() {
+                     src_pad.link(&sink_pad).map_err(Error::other)?;
+                 }
+-- 
